# =========================================================================
# GiftGauge environment variables
# Copy this file to .env and adjust values as needed.
# =========================================================================

# ----- Database (used by all backend services and the migrator) -----------
POSTGRES_USER=giftgauge
POSTGRES_PASSWORD=giftgauge
POSTGRES_DB=giftgauge

# DATABASE_URL is what the application services read.
# In docker-compose this resolves to the `db` service.
# In production, set this to your RDS connection string.
DATABASE_URL=postgres://giftgauge:giftgauge@db:5432/giftgauge

# ----- Service ports (overridable for local debugging) --------------------
PROFILE_SERVICE_PORT=3001
SHARING_SERVICE_PORT=3002
SCORING_SERVICE_PORT=3003

# ----- Logging ------------------------------------------------------------
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ----- AI configuration (scoring-service only) ----------------------------
# AI_MODE=mock        => deterministic local scoring, no external calls
# AI_MODE=openai      => calls the OpenAI Chat Completions API
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Frontend (Vite) ----------------------------------------------------
# These must be reachable from the BROWSER, not from inside the container.
VITE_PROFILE_API_URL=http://localhost:3001
VITE_SHARING_API_URL=http://localhost:3002
VITE_SCORING_API_URL=http://localhost:3003
